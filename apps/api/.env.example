# Ambiente: development | test | preview | production
ENVIRONMENT=development

# PostgreSQL 16 (async)
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/terus_dev

# JWT RS256 — obrigatórias em preview/production (PEM). Em development, um par efêmero é gerado.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Cookies: o navegador fala com a API via proxy do Next (/api/v1/*)
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/v1/auth
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_WEB_URL=http://localhost:3000

# Provedor de e-mail: not_configured (padrão honesto) | memory (somente testes)
MAILER_BACKEND=not_configured
