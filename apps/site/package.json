{
  "name": "@terus/site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-assets.mjs && next dev -p 3002",
    "build": "node scripts/sync-assets.mjs && next build",
    "start": "next start -p 3002",
    "lint": "node scripts/sync-assets.mjs && next lint",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "sync-assets": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.45.1",
    "@terus/schemas": "workspace:*",
    "@terus/types": "workspace:*",
    "@terus/ui": "workspace:*",
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.84.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@terus/config": "workspace:*",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4"
  },
  "description": "Nova experiência institucional + Self Onboarding 2.0 (isolada da LP em apps/web)"
}
